generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnvironmentKind {
  LOCAL
  STAGING
  PRODUCTION
  CLIENT_ISOLATED
}

enum OperationalStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum IdentityKind {
  TELEGRAM
  EMAIL
  PHONE
  APP_ACCOUNT
  EXTERNAL
}

enum ConsentChannel {
  TELEGRAM
  EMAIL
  SMS
  WEB
}

enum ConsentPurpose {
  PRODUCT_UPDATES
  MARKETING
  SUPPORT
  TOKEN_METERING
}

enum CampaignStatus {
  DRAFT
  READY
  SENDING
  PAUSED
  SENT
  FAILED
}

enum TokenAlertKind {
  BUDGET
  BURN_RATE
  ANOMALY
  POLICY_BREACH
}

enum TokenEmergencyAction {
  NONE
  DOWNGRADE_MODEL
  THROTTLE
  DISABLE_ASSISTANT
}

model Project {
  id           String            @id @default(cuid())
  key          String            @unique
  name         String
  owner        String
  category     String?
  workspace    String?
  runtime      String
  status       OperationalStatus @default(ACTIVE)
  repositories Repository[]
  controls     ProjectControl?
  aiKeyReferences AiKeyReference[]
  environments Environment[]
  assistants   Assistant[]
  events       Event[]
  tokenUsages  TokenUsageEvent[]
  tokenPolicies TokenPolicy[]
  feedback     FeedbackItem[]
  deployments  Deployment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Repository {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider      String
  name          String
  localPath     String?
  url           String?  @unique
  defaultBranch String   @default("main")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, name])
}

model ProjectControl {
  id                          String   @id @default(cuid())
  projectId                   String   @unique
  project                     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assistantEnabled            Boolean  @default(false)
  tokenTrackingRequired       Boolean  @default(false)
  feedbackCaptureRequired     Boolean  @default(false)
  rawMessageStorage           String   @default("disabled_by_default")
  consentRequiredForMarketing Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model AiKeyReference {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider         String
  secretRef        String
  displayName      String
  allowedModels    Json     @default("[]")
  defaultModel     String
  monthlyBudgetUsd Decimal  @db.Decimal(12, 2)
  environment      String   @default("production")
  rotationDueAt    DateTime?
  lastVerifiedAt   DateTime?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, secretRef])
}

model Environment {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        EnvironmentKind
  url         String?
  isolation   String          @default("founder-shared")
  deployments Deployment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Deployment {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  provider      String
  url           String
  status        OperationalStatus @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Assistant {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key           String
  name          String
  status        OperationalStatus @default(ACTIVE)
  tokenUsages   TokenUsageEvent[]
  tokenPolicies TokenPolicy[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([projectId, key])
}

model Person {
  id             String            @id @default(cuid())
  displayName    String?
  language       String?
  timezone       String?
  city           String?
  country        String?
  summaries      Json              @default("[]")
  tags           Json              @default("[]")
  facts          Json              @default("{}")
  identities     Identity[]
  consents       Consent[]
  events         Event[]
  tokenUsages    TokenUsageEvent[]
  feedback       FeedbackItem[]
  segmentMembers SegmentMember[]
  auditLogs      AuditLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Identity {
  id          String       @id @default(cuid())
  personId    String
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind        IdentityKind
  externalId  String
  verifiedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@unique([kind, externalId])
}

model Consent {
  id          String         @id @default(cuid())
  personId    String
  person      Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  channel     ConsentChannel
  purpose     ConsentPurpose
  granted     Boolean
  source      String
  recordedAt  DateTime       @default(now())
  expiresAt   DateTime?

  @@index([personId, channel, purpose])
}

model Event {
  id              String   @id @default(cuid())
  source          String
  idempotencyKey  String
  name            String
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  personId        String?
  person          Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  personRef       String?
  summary         String?
  tags            Json     @default("[]")
  facts           Json     @default("{}")
  occurredAt      DateTime
  storedAt        DateTime @default(now())

  @@unique([source, idempotencyKey])
  @@index([name, occurredAt])
  @@index([personRef])
}

model TokenUsageEvent {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assistantId  String?
  assistant    Assistant?  @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  personId     String?
  person       Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  environment  EnvironmentKind
  model        String
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  costUsd      Decimal     @db.Decimal(12, 6)
  occurredAt   DateTime
  createdAt    DateTime    @default(now())

  @@index([projectId, occurredAt])
  @@index([assistantId, occurredAt])
  @@index([model, occurredAt])
}

model TokenPolicy {
  id                    String                @id @default(cuid())
  projectId              String
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assistantId            String?
  assistant              Assistant?            @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  environment            EnvironmentKind?
  preferredModel         String
  fallbackModel          String
  dailyBudgetUsd         Decimal               @db.Decimal(12, 2)
  monthlyBudgetUsd       Decimal               @db.Decimal(12, 2)
  maxTokensPerRequest    Int
  emergencyMode          Boolean               @default(false)
  emergencyAction        TokenEmergencyAction  @default(NONE)
  alerts                 TokenAlert[]
  changes                TokenPolicyChange[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model TokenAlert {
  id          String         @id @default(cuid())
  policyId    String
  policy      TokenPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  kind        TokenAlertKind
  message     String
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
}

model TokenPolicyChange {
  id          String      @id @default(cuid())
  policyId    String
  policy      TokenPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  actor       String
  before      Json
  after       Json
  reason      String
  createdAt   DateTime    @default(now())
}

model FeedbackItem {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  source      String
  kind        String
  summary     String
  tags        Json     @default("[]")
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Segment {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  definition  Json
  members     SegmentMember[]
  campaigns   Campaign[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SegmentMember {
  id        String   @id @default(cuid())
  segmentId String
  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([segmentId, personId])
}

model Campaign {
  id          String         @id @default(cuid())
  key         String         @unique
  name        String
  segmentId   String?
  segment     Segment?       @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  channel     ConsentChannel
  status      CampaignStatus @default(DRAFT)
  message     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actor       String
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  subjectType String
  subjectId   String
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([subjectType, subjectId])
}
